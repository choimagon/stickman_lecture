  "scenes": [
    {
      "id": "why",
      "stage": "why",
      "title": "불확실한 객체들",
      "start": 0,
      "duration": 6,
      "learning_goal": "불확실한 객체들",
      "narration": "객체의 존재와 개수가 불확실할 때 어떻게 표현할까요?",
